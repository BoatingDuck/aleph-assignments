# Supabase Dashboard > Connect > Transaction pooler (port 6543)
# Copy the ENTIRE URI, including username/host/port; do not guess the hostname.
# DATABASE_URL is server-only: never expose it to the browser or commit .env.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REDACTED@POOLER_HOST:6543/postgres
RP_ORIGIN=https://your-t08-project.vercel.app
RP_ID=your-t08-project.vercel.app
# Local development (use a separate Supabase test project if desired):
# RP_ORIGIN=http://localhost:3000
# RP_ID=localhost
